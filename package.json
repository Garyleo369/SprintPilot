{
  "name": "sprintpilot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "npm ci --prefix backend && npm ci --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start": "npm start --prefix backend",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "test": "npm test --prefix backend",
    "test:e2e": "node --test test/browser.test.js",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e",
    "mcp": "node mcp-server/index.js"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
