PORT=5000
HOST=127.0.0.1
CLIENT_URL=http://localhost:5173
# Optional; defaults to backend/data/sprintpilot.db, shared by REST and MCP.
# Use an absolute path if overriding, so both processes use the same database.
# DATABASE_PATH=/absolute/path/to/sprintpilot.db
# Free local AI (recommended for development): install Ollama and run `ollama pull qwen3:4b`.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Optional hosted alternative. Never put this secret in frontend/VITE_* variables.
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:cerebras
